generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  phone         String   @unique @db.VarChar(11)
  studentId     String?  @unique @map("student_id") @db.VarChar(20)
  nickname      String?  @db.VarChar(50)
  avatarUrl     String?  @map("avatar_url")
  role          String   @default("user") @db.VarChar(10)
  runnerStatus  String   @default("pending") @map("runner_status") @db.VarChar(10)
  idCardUrl     String?  @map("id_card_url")
  studentCardUrl String? @map("student_card_url")
  balance       Decimal  @default(0.00) @db.Decimal(10, 2)
  totalEarned   Decimal  @default(0.00) @map("total_earned") @db.Decimal(10, 2)
  totalOrders   Int      @default(0) @map("total_orders")
  rating        Decimal  @default(5.0) @db.Decimal(2, 1)
  campusId      String?  @map("campus_id") @db.VarChar(50)
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders        Order[]  @relation("UserOrders")
  runnerOrders  Order[]  @relation("RunnerOrders")
  transactions  Transaction[]
  notifications Notification[]

  @@map("users")
}

model Order {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  runnerId         String?   @map("runner_id") @db.Uuid
  status           String    @default("pending") @db.VarChar(20)
  trackingNumber   String?   @map("tracking_number") @db.VarChar(50)
  courierCompany   String?   @map("courier_company") @db.VarChar(20)
  pickupCode       String?   @map("pickup_code") @db.VarChar(20)
  pickupLocation   String    @map("pickup_location")
  deliveryBuilding String    @map("delivery_building") @db.VarChar(100)
  deliveryRoom     String?   @map("delivery_room") @db.VarChar(50)
  deliverBy        DateTime? @map("deliver_by")
  deliverNote      String?   @map("deliver_note")
  itemPrice        Decimal   @default(0.00) @map("item_price") @db.Decimal(10, 2)
  deliveryFee      Decimal   @map("delivery_fee") @db.Decimal(10, 2)
  platformFee      Decimal   @default(0.00) @map("platform_fee") @db.Decimal(10, 2)
  totalAmount      Decimal   @map("total_amount") @db.Decimal(10, 2)
  packageSize      String?   @map("package_size") @db.VarChar(10)
  packagePhoto     String[]  @map("package_photo")
  createdAt        DateTime  @default(now()) @map("created_at")
  acceptedAt       DateTime? @map("accepted_at")
  pickedUpAt       DateTime? @map("picked_up_at")
  completedAt      DateTime? @map("completed_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason")
  rating           Int?
  review           String?

  user             User      @relation("UserOrders", fields: [userId], references: [id])
  runner           User?     @relation("RunnerOrders", fields: [runnerId], references: [id])
  transactions     Transaction[]
  notifications    Notification[]

  @@map("orders")
}

model Transaction {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  orderId       String?  @map("order_id") @db.Uuid
  type          String   @db.VarChar(20)
  amount        Decimal  @db.Decimal(10, 2)
  balanceBefore Decimal  @map("balance_before") @db.Decimal(10, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(10, 2)
  status        String   @default("pending") @db.VarChar(10)
  payChannel    String?  @map("pay_channel") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [userId], references: [id])
  order         Order?   @relation(fields: [orderId], references: [id])

  @@map("transactions")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(20)
  title     String   @db.VarChar(100)
  content   String?
  isRead    Boolean  @default(false) @map("is_read")
  orderId   String?  @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])

  @@map("notifications")
}
